{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lyricthing",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lyric-thing-db",
      "database_id": "4e35a3db-4ce4-4683-a53a-dd144222665e"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_STATE",
      "id": "b8c6394225c84c4ab1b65cc9032934bb"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://lyricthing.melodii7785.workers.dev",
    "CLIENT_ID": "2298bfff363944bfa2b6818eb5f7a2cf",
    "SPOTIFY_REDIRECT_URI": "https://lyricthing.melodii7785.workers.dev/auth/callback"
  }
}
